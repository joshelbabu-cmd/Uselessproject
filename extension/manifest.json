{
    "manifest_version": 3,

    "name": "Mouse Movement Therapist",

    "version": "1.0.0",

    "description": "A completely unnecessary therapist for your mouse.",

    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "tracker.js"
            ]
        }
    ]
}